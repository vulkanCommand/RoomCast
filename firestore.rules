rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isParticipantData(data) {
      return signedIn() && data.participants[request.auth.uid] == true;
    }

    function isParticipant(roomId) {
      return isParticipantData(room(roomId).data);
    }

    match /rooms/{roomId} {
      allow read: if isParticipantData(resource.data);
      allow create: if false;
      allow delete: if false;
      allow update: if false;

      match /sessions/{sessionId} {
        allow read: if isParticipant(roomId);
        allow create, delete: if false;
        allow update: if signedIn()
          && isParticipant(roomId)
          && (
            (request.auth.uid == room(roomId).data.hostUid
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['offer', 'status']))
            ||
            (request.auth.uid == room(roomId).data.guestUid
              && request.resource.data.diff(resource.data).changedKeys().hasOnly(['answer', 'status']))
          );

        match /hostCandidates/{candidateId} {
          allow read: if isParticipant(roomId);
          allow create: if signedIn() && request.auth.uid == room(roomId).data.hostUid;
          allow update, delete: if false;
        }

        match /guestCandidates/{candidateId} {
          allow read: if isParticipant(roomId);
          allow create: if signedIn() && request.auth.uid == room(roomId).data.guestUid;
          allow update, delete: if false;
        }
      }
    }
  }
}
